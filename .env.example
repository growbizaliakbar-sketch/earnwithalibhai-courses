# Copy to .env and fill in. NEVER commit .env.

# Public URL of the site (used in verification / reset emails). No trailing slash.
BASE_URL=http://localhost:3000

# Port to listen on.
PORT=3000

# Your email — the account created via "set password" with this address is auto-promoted to admin.
# Also the destination for contact-form notifications when SMTP is configured.
ADMIN_EMAIL=you@example.com

# Long random string. REQUIRED in production — the app warns if it is missing.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to 1 to force secure cookies (also auto-enabled when BASE_URL starts with https://).
COOKIE_SECURE=0

# Set to 1 when running behind a reverse proxy (nginx, Cloudflare, Render, etc.)
# so secure cookies and client IPs work correctly.
TRUST_PROXY=0

# ---- Email (SMTP). If SMTP_HOST is empty, the app runs in DEV outbox mode:
# emails are appended to data/mail-outbox.json and printed to the console,
# and the admin can view them at /admin/settings.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Shown as the sender, e.g. "Earn With Ali Bhai <no-reply@yourdomain.com>"
MAIL_FROM=Earn With Ali Bhai <no-reply@earnwithalibhai.com>

NODE_ENV=production

# ================= PRODUCTION MODE (stateless hosting, e.g. Render free tier) ==
# Leave this whole section EMPTY for local dev — the app then uses a local
# SQLite file (data/app.db) and uploads on disk, with zero config.
#
# ---- Database: Turso (libSQL, SQLite-compatible) ----
# Set TURSO_DATABASE_URL to switch the app to production database mode.
# Local Turso file:  TURSO_DATABASE_URL=file:/data/turso.db   (needs a disk)
# Remote Turso:      TURSO_DATABASE_URL=libsql://your-db-yourorg.turso.io
#                    TURSO_AUTH_TOKEN=<token from turso db tokens create>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
#
# ---- Object storage for thumbnails + videos ----
# STORAGE_BACKEND=local  — disk (default; local dev)
# STORAGE_BACKEND=inline — thumbnails stored in the DB (no extra accounts);
#                          lesson videos use the "External video URL" field
#                          (e.g. YouTube unlisted). Recommended for Render free.
# STORAGE_BACKEND=r2     — Cloudflare R2 (S3-compatible), needs the R2_* vars.
STORAGE_BACKEND=
# ---- Cloudflare R2 (only when STORAGE_BACKEND=r2) ----
# Create the bucket at dash.cloudflare.com -> R2 -> Create bucket, then
# create an API token (R2 -> Manage API tokens) with Object Read & Write.
STORAGE_BACKEND=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eabh-uploads
# Public base URL for thumbnails: either the r2.dev subdomain from your bucket
# settings, or your own domain (e.g. https://media.yourdomain.com). No trailing slash.
R2_PUBLIC_URL=
# Optional: how long (ms) the app waits for the Turso database at startup
# before failing with a clear error. Default 20000.
DB_STARTUP_TIMEOUT_MS=20000
