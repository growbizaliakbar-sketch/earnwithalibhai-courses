<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<section class="section auth-section">
  <div class="container narrow-sm">
    <div class="card auth-card reveal">
      <div class="auth-head">
        <img src="/images/logo.svg" alt="EA" width="48" height="48">
        <h1>Set your password</h1>
        <p class="muted">Step 3 of 3 — Assalam-o-Alaikum<%= name ? ', ' + name.split(' ')[0] : '' %>! Choose a strong password to finish.</p>
      </div>
      <form method="POST" action="/set-password/<%= token %>">
        <label class="field">
          <span>Password <small class="muted">(min 8 characters, letters + numbers)</small></span>
          <input type="password" name="password" required minlength="8" class="input" autocomplete="new-password">
        </label>
        <label class="field">
          <span>Confirm password</span>
          <input type="password" name="password_confirm" required minlength="8" class="input" autocomplete="new-password">
        </label>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Create account</button>
      </form>
      <div class="auth-steps">
        <span class="auth-step done">1 · Email</span>
        <span class="auth-step done">2 · Verify</span>
        <span class="auth-step active">3 · Password</span>
      </div>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
