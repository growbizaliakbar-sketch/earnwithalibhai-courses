<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<section class="section auth-section">
  <div class="container narrow-sm">
    <div class="card auth-card reveal">
      <div class="auth-head">
        <img src="/images/logo.svg" alt="EA" width="48" height="48">
        <h1>Create your account</h1>
        <p class="muted">Step 1 of 3 — enter your name and email. We'll send you a verification link.</p>
      </div>
      <form method="POST" action="/signup">
        <label class="field">
          <span>Full name</span>
          <input type="text" name="name" required maxlength="120" class="input" autocomplete="name" placeholder="e.g. Ali Akbar">
        </label>
        <label class="field">
          <span>Email address</span>
          <input type="email" name="email" required maxlength="160" class="input" autocomplete="email" placeholder="you@example.com">
        </label>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Send verification link</button>
      </form>
      <div class="auth-steps">
        <span class="auth-step active">1 · Email</span>
        <span class="auth-step">2 · Verify</span>
        <span class="auth-step">3 · Password</span>
      </div>
      <p class="auth-alt">Already have an account? <a href="/login">Log in</a></p>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
