<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<section class="section auth-section">
  <div class="container narrow-sm">
    <div class="card auth-card reveal">
      <div class="auth-head">
        <img src="/images/logo.svg" alt="EA" width="48" height="48">
        <h1>Forgot password</h1>
        <p class="muted">Enter your account email — we'll send a secure reset link.</p>
      </div>
      <form method="POST" action="/forgot-password">
        <label class="field">
          <span>Email address</span>
          <input type="email" name="email" required maxlength="160" class="input" autocomplete="email" placeholder="you@example.com">
        </label>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Send reset link</button>
      </form>
      <p class="auth-alt"><a href="/login">Back to login</a></p>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
