<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<section class="section auth-section">
  <div class="container narrow-sm">
    <div class="card auth-card reveal">
      <div class="auth-head">
        <img src="/images/logo.svg" alt="EA" width="48" height="48">
        <h1>Choose a new password</h1>
        <p class="muted">This link is single-use and expires after 1 hour.</p>
      </div>
      <form method="POST" action="/reset-password/<%= token %>">
        <label class="field">
          <span>New password <small class="muted">(min 8 characters, letters + numbers)</small></span>
          <input type="password" name="password" required minlength="8" class="input" autocomplete="new-password">
        </label>
        <label class="field">
          <span>Confirm new password</span>
          <input type="password" name="password_confirm" required minlength="8" class="input" autocomplete="new-password">
        </label>
        <button type="submit" class="btn btn-primary btn-lg btn-block">Reset password</button>
      </form>
    </div>
  </div>
</section>

<%- include('../partials/footer') %>
