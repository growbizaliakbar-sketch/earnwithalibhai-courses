<div class="admin-head">
  <h1>Users</h1>
  <form method="GET" action="/admin/users" class="filter-bar inline">
    <input type="search" name="q" value="<%= q %>" placeholder="Search name or email…" class="input" aria-label="Search users">
    <button type="submit" class="btn btn-primary btn-sm">Search</button>
  </form>
</div>

<div class="card">
  <div class="table-wrap">
    <table class="table">
      <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Courses</th><th>Joined</th><th></th></tr></thead>
      <tbody>
        <% users.forEach(function(u){ %>
        <tr>
          <td data-label="Name"><a href="/admin/users/<%= u.id %>"><%= u.name %></a></td>
          <td data-label="Email"><%= u.email %></td>
          <td data-label="Role"><span class="badge badge-<%= u.role %>"><%= u.role %></span></td>
          <td data-label="Status"><span class="badge badge-<%= u.status %>"><%= u.status.replace('_',' ') %></span></td>
          <td data-label="Courses"><%= u.course_count %></td>
          <td data-label="Joined"><%= new Date(u.created_at).toLocaleDateString('en-GB') %></td>
          <td><a href="/admin/users/<%= u.id %>" class="btn btn-ghost btn-sm">Manage</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
  <% if (!users.length) { %><p class="muted">No users found.</p><% } %>
</div>
