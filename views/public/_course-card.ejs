<% function fmtDur(s){ s = Number(s)||0; if(!s) return ''; if(s < 60) return s+'s'; var h = Math.floor(s/3600), m = Math.round((s%3600)/60); return h ? (h+'h '+(m?m+'m':'')) : (m+'m'); } %>
<a href="/courses/<%= c.slug %>" class="course-card reveal">
  <div class="course-thumb">
    <% if (c.thumbnail_path) { %>
      <img src="/media/thumb/<%= c.id %>" alt="<%= c.title %>" loading="lazy">
    <% } else { %>
      <div class="course-thumb-fallback"><span>EA</span></div>
    <% } %>
    <% if (c.category) { %><span class="badge badge-cat"><%= c.category %></span><% } %>
  </div>
  <div class="course-body">
    <h3><%= c.title %></h3>
    <% if (c.short_description) { %><p class="course-short"><%= c.short_description %></p><% } %>
    <div class="course-mentor">by <span class="mentor-link" data-href="/about">Ali Bhai</span></div>
    <div class="course-meta">
      <span>▶ <%= c.lesson_count %> lesson<%= c.lesson_count == 1 ? '' : 's' %><% if (Number(c.total_seconds) > 0) { %> · <%= fmtDur(c.total_seconds) %><% } %></span>
      <span class="course-price"><%= c.price %></span>
    </div>
  </div>
</a>
