<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%- include('../partials/flash') %>

<!-- HERO -->
<section class="hero">
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="container hero-inner">
    <div class="hero-copy reveal">
      <span class="eyebrow">Earn With Ali Bhai · Learning Platform</span>
      <h1 class="hero-title">Learn real skills.<br><span class="gold-text">Grow with barakah.</span></h1>
      <p class="hero-sub">Step-by-step courses that take you from zero to skilled — with honest guidance, practical lessons, and values you can stand behind.</p>
      <div class="hero-ctas">
        <a href="/courses" class="btn btn-gold btn-lg">Browse Courses</a>
        <a href="/signup" class="btn btn-outline btn-lg">Create Account</a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><strong>300+</strong><span>students mentored</span></div>
        <% if (stats.courses > 0) { %><div class="hero-stat"><strong><%= stats.courses %></strong><span>courses live</span></div><% } %>
        <% if (stats.lessons > 0) { %><div class="hero-stat"><strong><%= stats.lessons %></strong><span>video lessons</span></div><% } %>
        <div class="hero-stat"><strong>100%</strong><span>halal &amp; honest teaching</span></div>
      </div>
    </div>
    <div class="hero-visual reveal" aria-hidden="true">
      <div class="hero-card-float">
        <div class="hero-card-float-head"><span class="dot"></span><span class="dot"></span><span class="dot"></span></div>
        <div class="hero-progress-row"><span>Course progress</span><strong>72%</strong></div>
        <div class="progress"><div class="progress-bar" style="width:72%"></div></div>
        <div class="hero-lesson-row"><span class="tick">✓</span><span>Lesson 12 — Complete</span></div>
        <div class="hero-lesson-row"><span class="tick">✓</span><span>Lesson 13 — Complete</span></div>
        <div class="hero-lesson-row active"><span class="play">▶</span><span>Lesson 14 — Continue learning</span></div>
      </div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Simple process</span>
      <h2>How it works</h2>
      <p>Three steps — from signup to skilled.</p>
    </div>
    <div class="steps-grid">
      <a href="/signup" class="step-card reveal">
        <div class="step-num">1</div>
        <h3>Create your account</h3>
        <p>Sign up free and verify your email. Your personal dashboard and progress tracking are ready instantly.</p>
      </a>
      <a href="https://wa.me/923286800979?text=Assalam-o-Alaikum!%20Mujhe%20course%20mein%20enroll%20hona%20hai." target="_blank" rel="noopener" class="step-card reveal">
        <div class="step-num">2</div>
        <h3>Get enrolled</h3>
        <p>Message us on WhatsApp about the course you want. We assign it to your account — simple and personal.</p>
      </a>
      <a href="/courses" class="step-card reveal">
        <div class="step-num">3</div>
        <h3>Learn &amp; grow</h3>
        <p>Watch step-by-step lessons at your pace. Your progress is saved, so you always know what's next.</p>
      </a>
    </div>
    <div class="center mt reveal">
      <a href="https://wa.me/923286800979?text=Assalam-o-Alaikum!%20Mujhe%20course%20mein%20enroll%20hona%20hai." target="_blank" rel="noopener" class="btn btn-whatsapp btn-lg"><%- include('../partials/social-icons', { icon: 'whatsapp' }) %> Enroll via WhatsApp</a>
    </div>
  </div>
</section>

<!-- TRUST BAR -->
<section class="trustbar">
  <div class="container trustbar-inner reveal">
    <span>Faith-grounded</span><i>·</i>
    <span>Practical skills</span><i>·</i>
    <span>Step-by-step lessons</span><i>·</i>
    <span>Honest mentorship</span><i>·</i>
    <span>Learn at your pace</span>
  </div>
</section>

<!-- FEATURED COURSES -->
<section class="section" id="featured">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Featured</span>
      <h2>Start with our most loved courses</h2>
      <p>Carefully structured, beginner-friendly, and built for real results.</p>
    </div>
    <% if (featured && featured.length) { %>
    <div class="course-grid">
      <% featured.forEach(function(c){ %>
        <%- include('_course-card', { c: c }) %>
      <% }) %>
    </div>
    <div class="center mt"><a href="/courses" class="btn btn-primary">View all courses</a></div>
    <% } else { %>
    <div class="empty-state empty-soon reveal">
      <div class="empty-badge">Coming soon</div>
      <h3>Something special is on the way</h3>
      <p>Our first courses are being prepared with care. Be the first to know when they launch — message us and we'll notify you personally.</p>
      <div class="hero-ctas center">
        <a href="https://wa.me/923286800979?text=Assalam-o-Alaikum!%20Mujhe%20naye%20courses%20ke%20launch%20par%20notify%20karein." target="_blank" rel="noopener" class="btn btn-whatsapp"><%- include('../partials/social-icons', { icon: 'whatsapp' }) %> Notify me on WhatsApp</a>
        <a href="/signup" class="btn btn-ghost">Create free account</a>
      </div>
    </div>
    <% } %>
  </div>
</section>

