<!-- CATEGORIES -->
<% if (categories && categories.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head reveal">
      <span class="eyebrow">Categories</span>
      <h2>Find your path</h2>
    </div>
    <div class="cat-grid">
      <% categories.forEach(function(cat){ %>
      <a href="/courses?category=<%= encodeURIComponent(cat.name) %>" class="cat-card reveal">
        <h3><%= cat.name %></h3>
        <span><%= cat.course_count %> course<%= cat.course_count == 1 ? '' : 's' %></span>
      </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<!-- STUDENT SUCCESS -->
<section class="section section-tint">
